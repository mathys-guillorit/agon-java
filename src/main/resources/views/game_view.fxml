<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.bordeaux.ui.gui.controllers.GameViewController">

    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <Menu mnemonicParsing="false" text="File">
                <MenuItem mnemonicParsing="false" onAction="#startNewGame" text="New Game"/>
                <MenuItem mnemonicParsing="false" onAction="#loadGame" text="Load Game"/>
                <MenuItem mnemonicParsing="false" onAction="#saveGame" text="Save Game"/>
                <SeparatorMenuItem mnemonicParsing="false"/>
                <MenuItem mnemonicParsing="false" onAction="#showConfig" text="Configuration"/>
                <MenuItem mnemonicParsing="false" onAction="#showVersion" text="Info"/>
                <SeparatorMenuItem mnemonicParsing="false"/>
                <MenuItem mnemonicParsing="false" onAction="#quitGame" text="Quit"/>
            </Menu>

            <Menu mnemonicParsing="false" text="Game">
                <MenuItem mnemonicParsing="false" onAction="#undo" text="Undo"/>
                <MenuItem mnemonicParsing="false" onAction="#redo" text="Redo"/>
                <SeparatorMenuItem mnemonicParsing="false"/>
                <MenuItem mnemonicParsing="false" onAction="#pauseGame" text="Pause"/>
                <MenuItem mnemonicParsing="false" onAction="#requestHint" text="Hint"/>
                <MenuItem mnemonicParsing="false" onAction="#showHistory" text="History"/>
            </Menu>

            <Menu mnemonicParsing="false">
                <graphic>
                    <Label text="Help" onMouseClicked="#showHelp" style="-fx-cursor: hand;"/>
                </graphic>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <StackPane fx:id="boardContainer" style="-fx-background-color: #2b2b2b;" BorderPane.alignment="CENTER" />
    </center>

    <bottom>
        <HBox alignment="CENTER" minHeight="50.0" style="-fx-background-color: #d3d3d3;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label fx:id="messageLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;"
                   text="Welcome to Agon! The game is ready."/>
        </HBox>
    </bottom>

</BorderPane>